{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") -}}
#!/bin/sh
# Installs the CLI tools the dotfiles expect. Re-runs whenever this list changes.
set -e
sudo pacman -S --needed --noconfirm \
  zsh git fzf zoxide eza bat git-delta git-lfs lf neovim tmux
sudo pacman -S tree-sitter-cli

# herdr isn't packaged for Arch; its installer puts it in ~/.local/bin (no sudo).
# Updates after that come from `herdr update`.
if ! command -v herdr >/dev/null && [ ! -x "$HOME/.local/bin/herdr" ]; then
  curl -fsSL https://herdr.dev/install.sh | sh
fi
{{ end -}}
