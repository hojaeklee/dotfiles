# ---- Oh My Zsh -------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
# Completion dirs go on fpath BEFORE OMZ, so its compinit picks them up.
{{- if eq .chezmoi.os "darwin" }}
fpath+=(/opt/homebrew/share/zsh/site-functions ~/.zfunc)
{{- else }}
fpath+=(~/.zsh/pure ~/.zfunc)   # pure prompt is cloned here by .chezmoiexternal
{{- end }}

ZSH_THEME=""                        # Pure is loaded below instead
CASE_SENSITIVE="true"
zstyle ':omz:update' mode auto      # update automatically without asking

plugins=(git fzf zsh-autosuggestions zsh-vi-mode zsh-syntax-highlighting)  # keep syntax-highlighting last
source $ZSH/oh-my-zsh.sh

# ---- Prompt ----------------------------------------------------------------
autoload -U promptinit; promptinit
prompt pure

# ---- Tools -----------------------------------------------------------------
eval "$(zoxide init zsh --cmd cd)"
{{- if eq .chezmoi.os "darwin" }}

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/Users/hlee/miniconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/Users/hlee/miniconda3/etc/profile.d/conda.sh" ]; then
        . "/Users/hlee/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="/Users/hlee/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<
{{- end }}

# ---- Personal config (~/.config/zsh) ---------------------------------------
# Sourced after conda so PATH additions take precedence.
for f in ~/.config/zsh/{path,env,aliases,functions,completions,keybindings,secrets}.zsh(N); do
  source "$f"
done
{{- if eq .chezmoi.os "darwin" }}

# >>> open-knowledge cli >>>
# ! Contents within this block are managed by OpenKnowledge. Do not edit.
# ! Delete this whole block to opt out — OpenKnowledge will not re-add it.
[ -f "$HOME/.ok/env.sh" ] && . "$HOME/.ok/env.sh"
# <<< open-knowledge cli <<<
{{- end }}

